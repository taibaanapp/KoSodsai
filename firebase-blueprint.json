{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile data from LINE",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "pictureUrl": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName"]
    },
    "Cattle": {
      "title": "Cattle",
      "description": "Cattle in the farm",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "breed": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "status": { "type": "string", "enum": ["active", "sold", "deceased"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "breed", "birthDate", "gender", "status", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income and expense records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "cattleId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "category", "amount", "date", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/cattle/{cattleId}": {
      "schema": "Cattle",
      "description": "Cattle documents"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Transaction documents"
    }
  }
}
